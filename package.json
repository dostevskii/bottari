    "mcpb": "node scripts/build-mcpb.mjs",
    "prepublishOnly": "npm test && npm run pii"
  },
  "keywords": [
    "sync",
    "backup",
    "google-drive",
    "claude-code",
    "codex",
    "mcp",
    "cli",
    "cross-platform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dostevskii/bottari.git"
  },
  "homepage": "https://github.com/dostevskii/bottari#readme",
