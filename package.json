{
  "name": "bottari",
  "version": "0.1.0",
  "description": "Pack up your CLI world - skills, settings and sessions - and carry it between machines through your own Google Drive.",
  "type": "module",
  "bin": { "bottari": "bin/bottari.mjs" },
  "engines": { "node": ">=20" },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "README.ko.md",
    "SECURITY.md",
    "PRIVACY.md"
  ],
  "scripts": {
