# The local PII denylist holds the very identifiers it exists to keep out of
# the repository, so it must never be committed. check-pii verifies this.
.pii-denylist.local

# Machine-specific notes (real paths, addresses) live beside the docs but
# never inside the repository.
*.local.md

node_modules/
*.log
.DS_Store
.tmp/
dist/
